# Copy to .env. Only DATABASE_URL and BETTER_AUTH_SECRET are required;
# with no provider keys the built-in demo model is used.
DATABASE_URL=postgresql://agentv:agentv@127.0.0.1:5432/agentv
# openssl rand -base64 32
BETTER_AUTH_SECRET=
HOST=127.0.0.1
PORT=8787
PUBLIC_URL=http://localhost:8787
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Models are "provider/model". Users can pick any id in ALLOWED_MODELS.
DEFAULT_MODEL=demo/agent-v
# ALLOWED_MODELS=anthropic/claude-sonnet-5,openai/gpt-5.5,google/gemini-3-pro
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# GOOGLE_GENERATIVE_AI_API_KEY=
# Any OpenAI-compatible endpoint (Ollama, vLLM, LM Studio, OpenRouter, Groq…):
# OPENAI_COMPATIBLE_PROVIDERS=[{"name":"ollama","baseURL":"http://127.0.0.1:11434/v1","models":["llama3.3"]}]
# DEMO_MODEL=true

# Private files (PDFs, attachments) live here.
DATA_DIR=.agent-v/data

# Gmail and Google Calendar. Create an OAuth client (type: Web application) in Google Cloud,
# enable the Gmail and Calendar APIs, and register PUBLIC_URL/api/google/callback as a
# redirect URI. Tokens are encrypted with TOKEN_ENCRYPTION_KEY (openssl rand -base64 32).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TOKEN_ENCRYPTION_KEY=
# Until an account is connected, a fictional demo mailbox is used (off by default in production).
# DEMO_WORKSPACE=true

# Background task workers per process.
TASK_WORKERS=4
# Page checks run at once per process, and whether this process runs the every-minute watch
# scheduler (every process may; each check still runs once).
MONITOR_WORKERS=4
MONITOR_SCHEDULE=true
# Only for local development: let web_fetch reach private addresses.
# ALLOW_PRIVATE_NETWORK_FETCH=false

# Cloud browser worker (apps/browser): `pnpm dev:browser`. Same token on both sides.
# BROWSER_URL=http://127.0.0.1:8790
# BROWSER_TOKEN=  # openssl rand -hex 32
# BROWSER_DATA_DIR=.agent-v/browser
# CHROMIUM_PATH=   # optional; defaults to Playwright's Chromium
# Only for local development: let the browser reach private addresses.
# BROWSER_ALLOW_PRIVATE=false

# Private Linux computer per user (needs Docker). Build the image first:
#   docker build -t agent-v-computer:local apps/computer
# COMPUTER_PROVIDER=docker
# COMPUTER_IMAGE=agent-v-computer:local
# COMPUTER_RUNTIME=runsc          # optional: gVisor for stronger isolation
# COMPUTER_MEMORY_MB=1024
# COMPUTER_CPUS=1
# COMPUTER_COMMAND_TIMEOUT_SECONDS=120
