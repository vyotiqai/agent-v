# Copy to .env. Only DATABASE_URL and BETTER_AUTH_SECRET are required;
# with no provider keys the built-in demo model is used.
DATABASE_URL=postgresql://agentv:agentv@127.0.0.1:5432/agentv
# openssl rand -base64 32
BETTER_AUTH_SECRET=
HOST=127.0.0.1
PORT=8787
PUBLIC_URL=http://localhost:8787
# No sign-in: the app opens straight into one built-in account. Only for a server on your
# own computer (it only answers requests addressed to localhost).
# SINGLE_USER=true
# The last two are the desktop app (apps/desktop).
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,tauri://localhost,http://tauri.localhost

# Models are "provider/model". Users can pick any id in ALLOWED_MODELS.
DEFAULT_MODEL=demo/agent-v
# ALLOWED_MODELS=anthropic/claude-sonnet-5,openai/gpt-5.5,google/gemini-3-pro
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# GOOGLE_GENERATIVE_AI_API_KEY=
# Any OpenAI-compatible endpoint (Ollama, vLLM, LM Studio, OpenRouter, Groq…):
# OPENAI_COMPATIBLE_PROVIDERS=[{"name":"ollama","baseURL":"http://127.0.0.1:11434/v1","models":["llama3.3"]}]
# DEMO_MODEL=true

# Private files (PDFs, attachments) live here.
DATA_DIR=.agent-v/data

# Gmail and Google Calendar. Create an OAuth client (type: Web application) in Google Cloud,
# enable the Gmail and Calendar APIs, and register PUBLIC_URL/api/google/callback as a
# redirect URI. Tokens (Google and connectors) are encrypted with TOKEN_ENCRYPTION_KEY
# (openssl rand -base64 32). Required in production; derived from BETTER_AUTH_SECRET otherwise.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TOKEN_ENCRYPTION_KEY=
# Until an account is connected, a fictional demo mailbox is used (off by default in production).
# DEMO_WORKSPACE=true

# Memory search uses pgvector: run Postgres from the pgvector/pgvector image (docker compose does).
# Embeddings for memory: "demo/hash" works offline; better: "openai/text-embedding-3-small",
# "google/gemini-embedding-001" or "<compat-provider>/<model>".
EMBEDDING_MODEL=demo/hash
# Voice input: an OpenAI speech-to-text model (or any server with OpenAI's audio API via
# OPENAI_BASE_URL). Without it, browsers that have speech recognition use their own.
# TRANSCRIPTION_MODEL=openai/gpt-4o-mini-transcribe

# Push notifications. Phones use Expo's push service (set EXPO_ACCESS_TOKEN if you enabled push
# security). Browsers use Web Push: generate keys with `npx web-push generate-vapid-keys`
# (in development they are derived from BETTER_AUTH_SECRET).
# EXPO_ACCESS_TOKEN=
# WEB_PUSH_PUBLIC_KEY=
# WEB_PUSH_PRIVATE_KEY=
# WEB_PUSH_SUBJECT=mailto:you@example.com

# MCP connectors: a built-in sample server to try them (on by default outside production).
# MCP_DEMO=true

# Background task workers per process.
TASK_WORKERS=4
# Page checks run at once per process, and whether this process runs the every-minute watch
# scheduler (every process may; each check still runs once).
MONITOR_WORKERS=4
MONITOR_SCHEDULE=true
# Only for local development: let web_fetch reach private addresses.
# ALLOW_PRIVATE_NETWORK_FETCH=false

# Cloud browser worker (apps/browser): `pnpm dev:browser`. Same token on both sides.
# BROWSER_URL=http://127.0.0.1:8790
# BROWSER_TOKEN=  # openssl rand -hex 32
# BROWSER_DATA_DIR=.agent-v/browser
# CHROMIUM_PATH=   # optional; defaults to Playwright's Chromium
# Only for local development: let the browser reach private addresses.
# BROWSER_ALLOW_PRIVATE=false

# Private Linux computer per user (needs Docker). Build the image first:
#   docker build -t agent-v-computer:local apps/computer
# COMPUTER_PROVIDER=docker
# COMPUTER_IMAGE=agent-v-computer:local
# COMPUTER_RUNTIME=runsc          # optional: gVisor for stronger isolation
# COMPUTER_MEMORY_MB=1024
# COMPUTER_CPUS=1
# COMPUTER_COMMAND_TIMEOUT_SECONDS=120

# ——— Accounts, plans and operations (phase 7) ———

# Where people use the app (links in emails, checkout returns). Defaults to the first origin.
# APP_URL=http://localhost:8081

# Account emails: verification, password reset, team invitations. Unset: they're logged.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# EMAIL_FROM=Agent V <no-reply@example.com>

# Operators (the Admin screen): comma-separated emails.
# ADMIN_EMAILS=you@example.com

# Plans: unset for no limits; "default" for Free, Pro and Team; or a JSON array of plans.
# PLANS=default
# Stripe billing 