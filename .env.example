# Copy to .env. Only DATABASE_URL and BETTER_AUTH_SECRET are required;
# with no provider keys the built-in demo model is used.
DATABASE_URL=postgresql://agentv:agentv@127.0.0.1:5432/agentv
# openssl rand -base64 32
BETTER_AUTH_SECRET=
HOST=127.0.0.1
PORT=8787
PUBLIC_URL=http://localhost:8787
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Models are "provider/model". Users can pick any id in ALLOWED_MODELS.
DEFAULT_MODEL=demo/agent-v
# ALLOWED_MODELS=anthropic/claude-sonnet-5,openai/gpt-5.5,google/gemini-3-pro
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# GOOGLE_GENERATIVE_AI_API_KEY=
# Any OpenAI-compatible endpoint (Ollama, vLLM, LM Studio, OpenRouter, Groq…):
# OPENAI_COMPATIBLE_PROVIDERS=[{"name":"ollama","baseURL":"http://127.0.0.1:11434/v1","models":["llama3.3"]}]
# DEMO_MODEL=true

# Background task workers per process.
TASK_WORKERS=4
# Only for local development: let web_fetch reach private addresses.
# ALLOW_PRIVATE_NETWORK_FETCH=false
