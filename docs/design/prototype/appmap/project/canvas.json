   "x": 2200,
   "y": -300
  },
  "everyday": {
   "kind": "title1",
   "maxW": 3680,
   "text": "Every day",
   "w": 240,
   "x": 0,
   "y": -300
  },
  "find": {
   "kind": "title1",
