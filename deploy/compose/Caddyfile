# HTTPS with automatic certificates, HTTP/3, compression, and the API + web app behind it.
{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy server:8787 {
		# Replies stream (SSE) and the live browser view is a WebSocket: never buffer.
		flush_interval -1
	}
}
