# Production settings for deploy/compose. Copy to .env and fill in. Never commit .env.

# Where people reach Agent V (DNS must point here; Caddy fetches the certificate).
DOMAIN=agent.example.com

# openssl rand -base64 36
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
# openssl rand -hex 32
BROWSER_TOKEN=
# openssl rand -base64 32  (encrypts connected-account and connector tokens)
TOKEN_ENCRYPTION_KEY=

# Models: at least one provider.
DEFAULT_MODEL=anthropic/claude-sonnet-5
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
ALLOWED_MODELS=openai/gpt-5.5,google/gemini-3-pro
EMBEDDING_MODEL=openai/text-embedding-3-small
TRANSCRIPTION_MODEL=openai/gpt-4o-mini-transcribe

# Account emails (verification, password reset, team invitations).
SMTP_URL=smtps://user:password@smtp.example.com:465
EMAIL_FROM=Agent V <no-reply@agent.example.com>

# Operators (admin screen): comma-separated emails.
ADMIN_EMAILS=

# Plans and billing. Leave PLANS empty for no limits (a private deployment).
PLANS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICES={}

# Push notifications (npx web-push generate-vapid-keys).
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@agent.example.com
EXPO_ACCESS_TOKEN=

# Google (Gmail and Calendar).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Observability (with --profile observability): http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# Backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14
