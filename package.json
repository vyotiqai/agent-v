{
  "name": "agent-v",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:server": "pnpm --filter @agent-v/server dev",
    "dev:app": "pnpm --filter @agent-v/app dev",
    "db:migrate": "pnpm --filter @agent-v/server db:migrate",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "dev:browser": "pnpm --filter @agent-v/browser dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "turbo": "2.11.3",
    "typescript": "7.0.2"
  }
}
