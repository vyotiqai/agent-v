{
  "name": "agent-v",
  "private": true,
  "description": "Agent V: a personal AI agent for phones. See README.md.",
  "workspaces": [
    "app",
    "server",
    "tools/gallery"
  ],
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "check": "npm run lint && npm run typecheck && python3 tools/theme/generate.py --check && npm test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "theme": "python3 tools/theme/generate.py"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "24.13.6",
    "typescript": "6.0.3"
  }
}
